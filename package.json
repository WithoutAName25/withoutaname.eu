    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix ."
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "maintained node versions"
  ],
  "dependencies": {
    "file-saver": "^2.0.5",
    "nprogress": "^0.2.0"
  },
  "devDependencies": {
