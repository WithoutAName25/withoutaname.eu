    "postcss-preset-env": "^11.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.102.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
