    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.101.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
