{
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "playwright:install": "playwright install",
    "playwright:install:withDebs": "playwright install --with-deps",
    "test:e2e": "playwright test",
    "test:unit:watch": "vitest watch --ui",
    "test:unit:ci": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "svelte-kit sync && prettier --check . && eslint .",
    "lint:fix": "svelte-kit sync && prettier --write . && eslint --fix ."
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "maintained node versions"
  ],
  "dependencies": {
    "file-saver": "^2.0.5",
    "nprogress": "^0.2.0"
  },
  "devDependencies": {
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/adapter-vercel": "^7.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.4",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "open-props": "^1.7.23",
    "postcss": "^8.5.31",
    "postcss-jit-props": "^1.0.16",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.106.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
